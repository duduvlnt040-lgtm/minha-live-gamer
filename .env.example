# =========================================================================
# MINHA LIVE GAME — VARIÁVEIS DE AMBIENTE (RAILWAY + VERCEL)
# NUNCA exponha chaves secretas no frontend nem envie .env ao GitHub.
# =========================================================================

# -------------------------------------------------------------------------
# 1. BACKEND (RAILWAY — configure em Railway -> Service -> Variables)
# -------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Volume persistente do Railway (monte um Volume em /app/data!)
# O SQLite, uploads de jogos, capas e músicas ficam gravados aqui.
DATA_DIR=/app/data

# URL exata do Frontend no Vercel para liberar CORS com cookies/credenciais
FRONTEND_URL=https://seu-projeto.vercel.app
# Opcional: domínios extras separados por vírgula
CORS_ORIGINS=
ALLOW_VERCEL_PREVIEWS=true

# Cookies cross-origin HTTPS (Vercel -> Railway)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Segredos de criptografia (gere strings aleatórias longas)
SESSION_SECRET=substitua_por_uma_chave_secreta_aleatoria_forte
AUDIO_SIGNING_SECRET=substitua_por_outra_chave_hmac_aleatoria

# E-mail do proprietário / Administrador Vitalício
ADMIN_EMAIL=duduvlnt040@gmail.com

# Cakto Pagamentos & Webhook (Plano único R$ 49,99/mês)
CAKTO_OFFER_URL=https://cakto.com.br/checkout/minha-live-game-premium
CAKTO_PRODUCT_ID=prod_minha_live_game_premium
CAKTO_OFFER_ID=off_mensal_4990
CAKTO_WEBHOOK_SECRET=seu_segredo_webhook_cakto

# TikTok LIVE Connector (Opcional: chave EulerStream para maior taxa de conexões)
TIKTOK_SIGN_API_KEY=

# Supabase (Opcional: espelhamento/nuvem em paralelo ao volume persistente do Railway)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------------------
# 2. FRONTEND (VERCEL — configure em Vercel -> Project -> Environment Variables)
# -------------------------------------------------------------------------
# URL pública do seu backend no Railway (SEM barra no final)
VITE_API_URL=https://seu-backend.up.railway.app
# Opcional: URL explícita do WebSocket (se omitida, é derivada de VITE_API_URL)
VITE_WS_URL=wss://seu-backend.up.railway.app/ws/live
