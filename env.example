# =========================================================================
# MINHA LIVE GAME — VARIÁVEIS DE AMBIENTE (VERCEL & DESENVOLVIMENTO LOCAL)
# Copie este arquivo para .env (local) ou cadastre estas variáveis em:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
#
# ATENÇÃO: NUNCA exponha SUPABASE_SERVICE_ROLE_KEY, SESSION_SECRET ou
# CAKTO_WEBHOOK_SECRET em código frontend ou repositórios públicos.
# =========================================================================

# Ambiente e Servidor (usado em execução Node/VPS/local)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Segurança e Sessão HTTP-Only
SESSION_SECRET=substitua_por_uma_chave_secreta_aleatoria_forte
AUDIO_SIGNING_SECRET=substitua_por_outra_chave_hmac_aleatoria
COOKIE_SECURE=true

# Conta Proprietária / Administrador Vitalício
ADMIN_EMAIL=duduvlnt040@gmail.com

# Banco de Dados Supabase (obrigatório em produção no Vercel)
# Obtenha em: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-do-supabase

# Cakto Pagamentos & Webhook (Plano Único: MINHA LIVE GAME PREMIUM - R$ 49,99/mês)
CAKTO_OFFER_URL=https://cakto.com.br/checkout/minha-live-game-premium
CAKTO_PRODUCT_ID=prod_minha_live_game_premium
CAKTO_OFFER_ID=off_mensal_4990
CAKTO_WEBHOOK_SECRET=seu_segredo_webhook_cakto

# TikTok LIVE Connector
# Opcional: chave EulerStream para maior estabilidade/taxa de conexões simultâneas
TIKTOK_SIGN_API_KEY=

# Opcional (Frontend): URL externa de WebSocket caso hospede o servidor realtime
# (npm start) em Railway/Render/VPS separado do Vercel Serverless
# Exemplo: wss://realtime.minhalivegame.com/ws/live
VITE_WS_URL=
